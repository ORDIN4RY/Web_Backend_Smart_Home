# ============================================================
# .env.example — Contoh environment variables (opsional)
# Salin ke .env dan sesuaikan nilainya
# ============================================================

# Host & Port server Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Sumber frame kamera:
#   none        -> tanpa kamera (mobile-upload-only mode)
#   0           -> webcam lokal (index 0)
#   http://...  -> stream MJPEG ESP32-CAM
CAMERA_SOURCE=none

# Path model
MFN_REPO=MobileFaceNet
MFN_PRETRAINED=MobileFaceNet/weights/mobilefacenet.pt
YUNET_MODEL=face_detection_yunet_2023mar.onnx
FAS_MODEL_DIR=fas/models

# Threshold default (bisa diubah saat runtime via POST /api/config/threshold)
THRESHOLD=0.5
FAS_THRESHOLD=0.6
MARGIN=0.0
